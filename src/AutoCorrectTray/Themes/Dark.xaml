<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark palette. Keys match Themes/Light.xaml. -->
    <SolidColorBrush x:Key="BgWindow" Color="#1E2128"/>
    <SolidColorBrush x:Key="BgCard" Color="#262B35"/>
    <SolidColorBrush x:Key="BgAccent" Color="#24324A"/>
    <SolidColorBrush x:Key="BgButton" Color="#2E3440"/>
    <SolidColorBrush x:Key="BgHover" Color="#313847"/>
    <SolidColorBrush x:Key="BgPressed" Color="#3A4152"/>

    <SolidColorBrush x:Key="BorderSubtle" Color="#3A4050"/>
    <SolidColorBrush x:Key="BorderStrong" Color="#4A5266"/>

    <SolidColorBrush x:Key="TextPrimary" Color="#E8EAF0"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#A8AEBE"/>
    <SolidColorBrush x:Key="TextMuted" Color="#7A8194"/>

    <SolidColorBrush x:Key="Accent" Color="#4C86F0"/>
    <SolidColorBrush x:Key="AccentHover" Color="#6A9BF5"/>
    <SolidColorBrush x:Key="OnAccentText" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Danger" Color="#E06456"/>

    <SolidColorBrush x:Key="SwitchOn" Color="#D95FB8"/>
    <SolidColorBrush x:Key="SwitchOff" Color="#4A5266"/>
    <SolidColorBrush x:Key="SwitchThumb" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="OverlayBg" Color="#F21E222A"/>
    <SolidColorBrush x:Key="OverlayBorder" Color="#4A5266"/>
    <SolidColorBrush x:Key="OverlayText" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="OverlayMuted" Color="#9096A5"/>
</ResourceDictionary>
