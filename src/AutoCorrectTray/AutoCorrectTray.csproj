<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AutoCorrectTray</RootNamespace>
    <AssemblyName>AutoCorrectTray</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Product>AutoCorrect Tray</Product>
    <Description>T9-like word correction, autopunctuation and translation in any Windows text field</Description>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\logo.png"/>
    <Resource Include="Assets\tray.png"/>
    <Resource Include="Assets\tray_paused.png"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
    <PackageReference Include="WeCantSpell.Hunspell" Version="6.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AutoCorrectTray.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Dictionaries\**\*.*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
