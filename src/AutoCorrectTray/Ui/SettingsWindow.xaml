<Window x:Class="AutoCorrectTray.Ui.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource settings.title}" Width="620" Height="620"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize"
        Background="{DynamicResource BgWindow}" Foreground="{DynamicResource TextPrimary}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl>
            <TabItem Header="{DynamicResource tab.general}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="4,16,8,16">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{DynamicResource lbl.theme}" VerticalAlignment="Center"/>
                            <ComboBox x:Name="CmbTheme" Width="150" Height="28" Margin="10,0,0,0"
                                      SelectionChanged="CmbTheme_SelectionChanged">
                                <ComboBoxItem Content="{DynamicResource theme.light}" Tag="Light"/>
                                <ComboBoxItem Content="{DynamicResource theme.dark}" Tag="Dark"/>
                            </ComboBox>
                            <TextBlock Text="{DynamicResource lbl.language}" VerticalAlignment="Center" Margin="24,0,0,0"/>
                            <ComboBox x:Name="CmbLanguage" Width="150" Height="28" Margin="10,0,0,0"
                                      SelectionChanged="CmbLanguage_SelectionChanged">
                                <ComboBoxItem Content="English" Tag="en"/>
                                <ComboBoxItem Content="Russian" Tag="ru"/>
                            </ComboBox>
                        </StackPanel>

                        <CheckBox x:Name="ChkSpell" Content="{DynamicResource chk.spell}" Margin="0,18,0,0"/>
                        <CheckBox x:Name="ChkRightClick" Content="{DynamicResource chk.rightclick}" Margin="0,12,0,0"/>
                        <CheckBox x:Name="ChkDoubleClick" Content="{DynamicResource chk.doubleclick}" Margin="0,12,0,0"/>
                        <CheckBox x:Name="ChkAutoPeriod" Content="{DynamicResource chk.autoperiod}" Margin="0,12,0,0"/>
                        <CheckBox x:Name="ChkAutoCapital" Content="{DynamicResource chk.autocapital}" Margin="0,12,0,0"/>
                        <CheckBox x:Name="ChkSpaceAfter" Content="{DynamicResource chk.spaceafter}" Margin="0,12,0,0"/>
                        <CheckBox x:Name="ChkTranslate" Content="{DynamicResource chk.translate.on}" Margin="0,12,0,0"/>
                        <CheckBox x:Name="ChkAutoReplaceLive" Content="{DynamicResource chk.autoreplace}" Margin="0,12,0,0"/>
                        <TextBlock Text="{DynamicResource settings.note}"
                                   TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}" Margin="0,18,0,0" FontSize="12"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{DynamicResource tab.hotkeys}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="4,16,8,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="230"/>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="{DynamicResource lbl.fix}" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtFixHotkey" Grid.Column="1" IsReadOnly="True" Height="28"/>
                            <Button x:Name="BtnRecordFix" Grid.Column="2" Content="{DynamicResource btn.record}" Width="80" Height="28" Margin="8,0,0,0"/>

                            <TextBlock Grid.Row="2" Text="{DynamicResource lbl.translate.sel}" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtTranslateHotkey" Grid.Row="2" Grid.Column="1" IsReadOnly="True" Height="28"/>
                            <Button x:Name="BtnRecordTranslate" Grid.Row="2" Grid.Column="2" Content="{DynamicResource btn.record}" Width="80" Height="28" Margin="8,0,0,0"/>

                            <TextBlock Grid.Row="4" Text="{DynamicResource lbl.region}" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtCaptureHotkey" Grid.Row="4" Grid.Column="1" IsReadOnly="True" Height="28"/>
                            <Button x:Name="BtnRecordCapture" Grid.Row="4" Grid.Column="2" Content="{DynamicResource btn.record}" Width="80" Height="28" Margin="8,0,0,0"/>

                            <TextBlock Grid.Row="6" Text="{DynamicResource lbl.pause}" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtPauseHotkey" Grid.Row="6" Grid.Column="1" IsReadOnly="True" Height="28"/>
                            <Button x:Name="BtnRecordPause" Grid.Row="6" Grid.Column="2" Content="{DynamicResource btn.record}" Width="80" Height="28" Margin="8,0,0,0"/>
                        </Grid>
                        <TextBlock x:Name="TxtHotkeyStatus" TextWrapping="Wrap" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Accent}" Margin="0,12,0,0" FontSize="12.5"/>
                        <TextBlock Text="{DynamicResource hotkey.hint}"
                                   TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}" Margin="0,10,0,0" FontSize="12"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{DynamicResource tab.translate}">
                <StackPanel Margin="4,16,8,16">
                    <CheckBox x:Name="ChkAutoTranslateSelection"
                              Content="{DynamicResource chk.autotranslate.sel}"
                              Margin="0,0,0,14"/>
                    <TextBlock Text="{DynamicResource lbl.src.lang}"/>
                    <ComboBox x:Name="CmbSourceLang" DisplayMemberPath="Name" Margin="0,6,0,14" Height="28"/>
                    <TextBlock Text="{DynamicResource lbl.tgt.lang}"/>
                    <ComboBox x:Name="CmbTargetLang" DisplayMemberPath="Name" Margin="0,6,0,14" Height="28"/>
                    <TextBlock Text="{DynamicResource translate.note}"
                               TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}" FontSize="12"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="{DynamicResource tab.dict}">
                <Grid Margin="4,16,8,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{DynamicResource dict.label}"
                               VerticalAlignment="Top" FontSize="12.5"/>
                    <ListBox x:Name="LstUserWords" Grid.Row="0" Margin="0,24,0,0"/>
                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtNewWord" Height="28"/>
                        <Button x:Name="BtnAddWord" Grid.Column="1" Content="{DynamicResource btn.add}" Width="90" Height="28" Margin="8,0,0,0"/>
                        <Button x:Name="BtnRemoveWord" Grid.Column="2" Content="{DynamicResource btn.remove}" Width="130" Height="28" Margin="8,0,0,0"/>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="{DynamicResource tab.exclusions}">
                <Grid Margin="4,16,8,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{DynamicResource excl.label}"
                               VerticalAlignment="Top" FontSize="12.5" TextWrapping="Wrap"/>
                    <ListBox x:Name="LstBlacklist" Grid.Row="0" Margin="0,40,0,0"/>
                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtNewApp" Height="28"/>
                        <Button x:Name="BtnAddApp" Grid.Column="1" Content="{DynamicResource btn.add}" Width="90" Height="28" Margin="8,0,0,0"/>
                        <Button x:Name="BtnRemoveApp" Grid.Column="2" Content="{DynamicResource btn.remove}" Width="130" Height="28" Margin="8,0,0,0"/>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <CheckBox x:Name="ChkAutostart" Content="{DynamicResource chk.autostart}" VerticalAlignment="Center" Margin="0,0,18,0"/>
            <Button x:Name="BtnSave" Content="{DynamicResource btn.save}" Width="110" Height="30" IsDefault="True"/>
            <Button x:Name="BtnClose" Content="{DynamicResource btn.close}" Width="90" Height="30" Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
